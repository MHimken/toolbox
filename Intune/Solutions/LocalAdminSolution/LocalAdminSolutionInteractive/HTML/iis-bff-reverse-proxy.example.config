<?xml version="1.0" encoding="utf-8"?>
<!--
  Example only. Merge the rewrite rule into web.config after installing and
  enabling IIS URL Rewrite and Application Request Routing proxy support.

  Browser URL:
    https://reports.example.com/localadmin-api/v1/profile

  Upstream URL:
    https://YOUR-FUNCTION.azurewebsites.net/v1/profile

  Configure config.json bffBaseUrl as "/localadmin-api/v1".
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Local Admin BFF reverse proxy" stopProcessing="true">
          <match url="^localadmin-api/(.*)$" />
          <action type="Rewrite" url="https://YOUR-FUNCTION.azurewebsites.net/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
